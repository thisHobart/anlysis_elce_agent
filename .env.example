# Copy this file to .env and adjust for each environment.
# Required research model with native Function Calling. Select the endpoint's
# actual Chat Completions or Responses protocol; the app does not auto-switch.
VPP_LLM_PROVIDER=custom
VPP_LLM_API_STYLE=chat
# OpenAI 兼容接口的结构化输出方式：function_calling | json_schema | json_mode | prompt_json
# 必须通过 Cherry 调用 Gemini 时使用 prompt_json：schema 写入提示，本地严格校验。
# Gemini provider 不读取此项，固定通过 Google 原生 API 使用 json_schema。
VPP_LLM_STRUCTURED_OUTPUT_METHOD=function_calling
VPP_LLM_BASE_URL=
VPP_LLM_API_KEY=
VPP_LLM_MODEL=
# Gemini 原生适配器可使用 Gemini Developer API（API key），也可使用 Vertex AI（ADC）。
# Vertex AI 模式下，VPP_LLM_MODEL 只填写 gemini-* 模型名，不填写 Cherry 的 vertexai: 前缀。
VPP_LLM_GOOGLE_VERTEXAI=false
VPP_LLM_GOOGLE_PROJECT=
VPP_LLM_GOOGLE_LOCATION=
# Optional backend-only override. Leave empty unless the endpoint documents
# reasoning_effort (Chat) or reasoning.effort (Responses).
VPP_LLM_REASONING_EFFORT=
# Reasoning endpoints answer slowly; keep this at or above 120 seconds for them.
VPP_LLM_TIMEOUT_SECONDS=120
VPP_LLM_MAX_RETRIES=1
# strip discards reasoning traces the endpoint still returns; reject fails closed.
VPP_LLM_THINKING_POLICY=strip
# Approximate recent-message budget; 8 is selected as four complete historical turns.
VPP_LLM_HISTORY_MESSAGES=8
# Complete earlier turns retrieved by lexical relevance; 0 disables retrieval.
VPP_LLM_RETRIEVED_TURNS=3

# Optional additional Agent Skills roots. Separate multiple Windows paths with semicolons.
VPP_SKILL_PATHS=

# Shandong FEATURE is used by the desktop region button for actual electricity
# prices and by P2 preparation for load/generation. ANALYTICS supplies the
# desktop's actual and forecast weather factors and P2's weather/coal sources.
# Use read-only accounts and never commit real values.
VPP_SHANDONG_DB_FEATURE_HOST=
VPP_SHANDONG_DB_FEATURE_PORT=3306
VPP_SHANDONG_DB_FEATURE_USER=
VPP_SHANDONG_DB_FEATURE_PASSWORD=
VPP_SHANDONG_DB_FEATURE_NAME=
VPP_SHANDONG_DB_ANALYTICS_HOST=
VPP_SHANDONG_DB_ANALYTICS_PORT=3306
VPP_SHANDONG_DB_ANALYTICS_USER=
VPP_SHANDONG_DB_ANALYTICS_PASSWORD=
VPP_SHANDONG_DB_ANALYTICS_NAME=

# The desktop region selector reads its non-secret catalog from
# configs/region_databases.yaml. Add another catalog row and an environment
# variable group with the referenced prefix when a new region is onboarded.
# PRICE_RESEARCH_REGION_DATABASES may point to an operator-managed catalog.
PRICE_RESEARCH_REGION_DATABASES=
