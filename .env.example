# Copy this file to .env and adjust for each environment.
VPP_APP_NAME=VPP LangGraph Agent
VPP_ENVIRONMENT=development
VPP_ALLOWED_ORIGINS=http://localhost:3000
VPP_ENABLE_SCREEN_ACTIONS=true
VPP_LOG_LEVEL=INFO

# P3 local OpenAI-compatible model (disabled until configured).
VPP_LLM_ENABLED=true
VPP_LLM_BASE_URL=http://llm.example.invalid:11434/v1
VPP_LLM_API_KEY=None
VPP_LLM_MODEL=qwen3.6:27b
VPP_LLM_TIMEOUT_SECONDS=20
VPP_LLM_MAX_RETRIES=1
VPP_LLM_STRUCTURED_MODE=json_prompt
VPP_LLM_HISTORY_MESSAGES=8

# P5 MySQL database (read-only account)
VPP_DB_HOST=db.example.invalid
VPP_DB_PORT=3306
VPP_DB_USER=readonly_user
VPP_DB_PASSWORD=
VPP_DB_NAME=example_db
VPP_DB_CHARSET=utf8mb4

# P6 Knowledge Search (RAG)
VPP_QDRANT_HOST=localhost
VPP_QDRANT_PORT=6333
VPP_KNOWLEDGE_COLLECTION=vpp_knowledge
VPP_KNOWLEDGE_TOP_K=3
VPP_KNOWLEDGE_MODEL_PATH=BAAI/bge-small-zh-v1.5
