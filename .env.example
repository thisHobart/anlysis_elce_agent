# Copy this file to .env and adjust for each environment.
# Required research-model connection identity. Protocol, model capacity,
# retry/history policy, and Gemini Vertex options are stored in the per-user
# PriceResearchAgent settings/model_profiles JSON files managed by the desktop.
VPP_LLM_PROVIDER=custom
VPP_LLM_BASE_URL=
VPP_LLM_API_KEY=
VPP_LLM_MODEL=

# Optional frozen JSONL corpus for the desktop P1→P2→P3 workflow.
# Leave empty to use the audited Shandong snapshot bundled with the project.
VPP_P2_NEWS_PATH=

# Optional additional Agent Skills roots. Separate multiple Windows paths with semicolons.
VPP_SKILL_PATHS=

# Optional MCP server catalog. Leave empty to use configs/mcp_servers.yaml.
# Secrets stay in this file; the YAML catalog only names environment variables.
PRICE_RESEARCH_MCP_SERVERS=

# Shandong FEATURE is used by the desktop region button for actual electricity
# prices and by P2 preparation for load/generation. ANALYTICS supplies the
# desktop's actual and forecast weather factors and P2's weather/coal sources.
# Use read-only accounts and never commit real values.
VPP_SHANDONG_DB_FEATURE_HOST=
VPP_SHANDONG_DB_FEATURE_PORT=3306
VPP_SHANDONG_DB_FEATURE_USER=
VPP_SHANDONG_DB_FEATURE_PASSWORD=
VPP_SHANDONG_DB_FEATURE_NAME=
VPP_SHANDONG_DB_ANALYTICS_HOST=
VPP_SHANDONG_DB_ANALYTICS_PORT=3306
VPP_SHANDONG_DB_ANALYTICS_USER=
VPP_SHANDONG_DB_ANALYTICS_PASSWORD=
VPP_SHANDONG_DB_ANALYTICS_NAME=

# Sichuan uses three logical databases on the same service: PRICE contains the
# real-time price and intraday cleared quantities, FEATURE contains load and
# generation series, and ANALYTICS contains ERA5/GFS weather data.
VPP_SICHUAN_DB_PRICE_HOST=
VPP_SICHUAN_DB_PRICE_PORT=3306
VPP_SICHUAN_DB_PRICE_USER=
VPP_SICHUAN_DB_PRICE_PASSWORD=
VPP_SICHUAN_DB_PRICE_NAME=api_data
VPP_SICHUAN_DB_FEATURE_HOST=
VPP_SICHUAN_DB_FEATURE_PORT=3306
VPP_SICHUAN_DB_FEATURE_USER=
VPP_SICHUAN_DB_FEATURE_PASSWORD=
VPP_SICHUAN_DB_FEATURE_NAME=original_data_sichuan
VPP_SICHUAN_DB_ANALYTICS_HOST=
VPP_SICHUAN_DB_ANALYTICS_PORT=3306
VPP_SICHUAN_DB_ANALYTICS_USER=
VPP_SICHUAN_DB_ANALYTICS_PASSWORD=
VPP_SICHUAN_DB_ANALYTICS_NAME=vpp1.0

# The desktop region selector reads its non-secret catalog from
# configs/region_databases.yaml. Add another catalog row and an environment
# variable group with the referenced prefix when a new region is onboarded.
# PRICE_RESEARCH_REGION_DATABASES may point to an operator-managed catalog.
PRICE_RESEARCH_REGION_DATABASES=
