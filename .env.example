# Copy this file to .env and adjust for each environment.
# Required OpenAI-compatible model for research planning and revision.
VPP_LLM_BASE_URL=
VPP_LLM_API_KEY=
VPP_LLM_MODEL=
VPP_LLM_TIMEOUT_SECONDS=20
VPP_LLM_MAX_RETRIES=1
# Conversation turns sent to the model with each planning or dialogue request.
VPP_LLM_HISTORY_MESSAGES=8

# Optional additional Agent Skills roots. Separate multiple Windows paths with semicolons.
VPP_SKILL_PATHS=
